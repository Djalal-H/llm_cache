# API: uv run uvicorn cachewise.api:app --host 127.0.0.1 --port 8000
CACHEWISE_GENERATION_BASE_URL=http://127.0.0.1:8001/v1
CACHEWISE_GENERATION_MODEL=cachewise-model
CACHEWISE_GENERATION_API_KEY=
CACHEWISE_GENERATION_TIMEOUT_SECONDS=120
CACHEWISE_TEMPERATURE=0
CACHEWISE_MAX_TOKENS=256
# Optional, independently configured providers; unused by the uncached assistant.
CACHEWISE_EMBEDDING_BASE_URL=
CACHEWISE_EMBEDDING_MODEL=
CACHEWISE_EMBEDDING_API_KEY=
CACHEWISE_EMBEDDING_TIMEOUT_SECONDS=30
CACHEWISE_JUDGE_BASE_URL=
CACHEWISE_JUDGE_MODEL=
CACHEWISE_JUDGE_API_KEY=
CACHEWISE_JUDGE_TIMEOUT_SECONDS=120
# Engine endpoint has no /v1 suffix; snapshots are aggregate, not request hits.
CACHEWISE_VLLM_METRICS_URL=http://127.0.0.1:8001/metrics
# Response cache modes: disabled, exact, semantic. Keep disabled for baseline replay.
CACHEWISE_CACHE_MODE=disabled
CACHEWISE_REDIS_URL=redis://127.0.0.1:6379/0
CACHEWISE_CACHE_TTL_SECONDS=86400
CACHEWISE_CACHE_TIMEOUT_SECONDS=1
# Set this when replacing model weights behind the same served model name.
CACHEWISE_GENERATION_MODEL_REVISION=
# Required for /admin/invalidate; blank disables the endpoint. Never commit a real token.
CACHEWISE_ADMIN_TOKEN=

# Semantic mode additionally requires the embedding endpoint/model above and these settings.
# Set the actual output dimension; threshold below is an example, not a quality-approved value.
# CACHEWISE_EMBEDDING_DIMENSION=768
# CACHEWISE_SEMANTIC_THRESHOLD=0.95
# Change revision when embedding weights or preprocessing change behind the same model name.
CACHEWISE_EMBEDDING_MODEL_REVISION=

# Read-only Streamlit dashboard (local defaults; Compose mounts ./artifacts read-only).
CACHEWISE_DASHBOARD_API_URL=http://127.0.0.1:8000
CACHEWISE_DASHBOARD_ARTIFACTS_DIR=artifacts
